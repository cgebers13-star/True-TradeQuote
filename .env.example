# --- TradeQuote environment configuration ---
# Copy this file to .env and fill in your keys.

# Required for the chat/scoping/estimating assistant to work.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional but required for LIVE tradesmen matching (Step 6 of the master prompt).
# Enable "Places API" and "Geocoding API" in Google Cloud Console, then create an API key.
# https://console.cloud.google.com/apis/credentials
# If left blank, TradeQuote automatically falls back to realistic demo/mock
# tradesmen listings so the app still runs end-to-end without this key.
GOOGLE_PLACES_API_KEY=

# Which Claude model to use for the assistant.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Port the local server listens on.
PORT=3000
